// =============================================================================================
// ASIM Network Session Parser (parameterless / "ASim") -- Cisco Meraki (Custom)
// =============================================================================================
// Thin wrapper around vimNetworkSessionCiscoMerakiCustom, called with no-op filter values.
// This is the standard ASIM parameterless-parser pattern: it exists so tools/queries that
// expect a zero-argument, always-return-everything view of the schema (rather than the
// filtering "vim" function) have something to call directly, and so it can be registered
// as a Kusto view for auto-discovery by _ASim_NetworkSession().
//
// DEPENDENCY: vimNetworkSessionCiscoMerakiCustom must already be saved as a function in
// this workspace before saving this one -- deploy vimNetworkSessionCiscoMerakiCustom.kql
// first.
//
// DEPLOYMENT
// -----------------------------------------------------------------------------------------
// 1. Confirm vimNetworkSessionCiscoMerakiCustom is already saved as a function.
// 2. Paste this file into Log Analytics / Microsoft Sentinel > Logs and run it to confirm
//    it returns rows.
// 3. "Save as Function", name it exactly ASimNetworkSessionCiscoMerakiCustom.
// 4. Register this name in the workspace-deployed ASim_NetworkSessionCustom "Custom" slot
//    so _ASim_NetworkSession() picks it up automatically alongside the built-in sources.
// =============================================================================================
let ASimNetworkSessionCiscoMerakiCustom = view() {
    vimNetworkSessionCiscoMerakiCustom(
        starttime = datetime(null),
        endtime = datetime(null),
        srcipaddr_has_any_prefix = dynamic([]),
        dstipaddr_has_any_prefix = dynamic([]),
        ipaddr_has_any_prefix = dynamic([]),
        dstportnumber = int(null),
        hostname_has_any = dynamic([]),
        dvcaction = dynamic([]),
        eventresult = '*',
        disabled = false
    )
};
ASimNetworkSessionCiscoMerakiCustom
