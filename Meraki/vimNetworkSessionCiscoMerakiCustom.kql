// =============================================================================================
// ASIM Network Session Parser (parameter-based / "vim") -- Cisco Meraki (Custom)
// =============================================================================================
// Source table   : meraki_CL
// Ingestion path : Custom Logs via AMA (rsyslog -> text file -> AMA -> DCR -> meraki_CL)
// Schema         : ASIM NetworkSession, schema version 0.2.7 (verify against current docs
//                  at deploy time -- https://learn.microsoft.com/azure/sentinel/normalization-schema-network)
//
// WHY THIS PARSER EXISTS
// -----------------------------------------------------------------------------------------
// Neither published Microsoft parser covers this data path:
//   - ASimNetworkSessionCiscoMeraki targets CiscoMerakiNativePoller_CL (the REST API/
//     native-poller connector) filtered to EventOriginalType == "IDS Alert" only.
//     It never reads meraki_CL and never carries flow/firewall data even if it did.
//   - ASimNetworkSessionCiscoMerakiSyslog targets the generic "Syslog" table (AMA Syslog
//     connector), not the meraki_CL custom table produced by the officially documented
//     Custom Logs via AMA method (which exists specifically because the plain Syslog
//     connector mangles Meraki's key=value payloads at the first "=" sign).
//   - Workspace-deployed versions _Im_NetworkSession_CiscoMerakiV11/V12 additionally
//     assume legacy MMA/OMS-agent columns (SourceSystem, Computer, MG, ManagementGroupName)
//     that AMA/DCR-based custom log ingestion does not create, causing a hard
//     "project-away ... Failed to resolve attribute" error (V12) or silent zero rows (V11).
//
// RAW MESSAGE FORMAT (confirmed against production meraki_CL samples)
// -----------------------------------------------------------------------------------------
//   <collector-ISO8601-timestamp> <collector-hostname>  <meraki-epoch> <device-name> <logtype> <kv-pairs...>
//   e.g. 2026-07-31T04:51:15.309763+00:00 mil-firewall.du.it  1785473475.312289417 MX95_under flows src=... pattern: allow all
//
// KNOWN GOTCHA: do NOT categorize LogType by scanning the raw message text (e.g. "has_any('firewall')").
// If a device hostname happens to contain a LogType keyword (as in the sample above,
// "mil-firewall.du.it"), text-scanning approaches misclassify every message from that
// device. This parser always matches on the EventOriginalType field extracted from its
// fixed token position, never on raw text.
// =============================================================================================
let vimNetworkSessionCiscoMerakiCustom = (
    starttime: datetime = datetime(null),
    endtime: datetime = datetime(null),
    srcipaddr_has_any_prefix: dynamic = dynamic([]),
    dstipaddr_has_any_prefix: dynamic = dynamic([]),
    ipaddr_has_any_prefix: dynamic = dynamic([]),
    dstportnumber: int = int(null),
    hostname_has_any: dynamic = dynamic([]),
    dvcaction: dynamic = dynamic([]),
    eventresult: string = '*',
    disabled: bool = false
    ) {
    let _EventSchemaVersion = '0.2.7';
    let src_or_any = set_union(srcipaddr_has_any_prefix, ipaddr_has_any_prefix);
    let dst_or_any = set_union(dstipaddr_has_any_prefix, ipaddr_has_any_prefix);
    //
    // LogType groups kept as named lists (not inline literals) so that a firmware update
    // renaming a LogType only needs a one-line change here, not a rewrite of the filter
    // logic. Firewall-rule-match logs are all functionally identical across these names --
    // Meraki firmware >= MX18.101 splits the old single "flows" type into firewall /
    // vpn_firewall / cellular_firewall / bridge_anyconnect_client_vpn_firewall.
    //
    let FirewallLogTypes = dynamic(['flows', 'firewall', 'vpn_firewall', 'cellular_firewall', 'bridge_anyconnect_client_vpn_firewall']);
    let IpFlowLogTypes   = dynamic(['ip_flow_start', 'ip_flow_end']);
    //
    // "events" is a large multi-purpose LogType (wireless assoc/disassoc, DHCP anomalies,
    // VRRP, AnyConnect VPN, air marshal...). Only VPN connection events are modeled as
    // NetworkSession here; extend this list if you want to recognize more subtypes.
    // Everything else under "events" is intentionally left unparsed by this function --
    // most of it (wireless auth, DHCP) maps better to other ASIM schemas (Authentication,
    // DHCPEvent) than NetworkSession.
    //
    let VpnEventKeyword = 'vpn_connection';
    let MerakiBase =
        meraki_CL
        | where not(disabled)
        // Cheap, indexed pre-filter on ingestion time before any parsing work.
        | where (isnull(starttime) or TimeGenerated >= starttime)
            and (isnull(endtime) or TimeGenerated <= endtime)
        // Coarse pre-filter on raw text when a hostname filter is supplied -- this is a
        // performance shortcut only. The exact match against the parsed DvcHostname field
        // happens later in the pipeline; this line only avoids doing full regex/parse-kv
        // work on rows that can be cheaply ruled out first.
        | where array_length(hostname_has_any) == 0
            or tostring(column_ifexists('Message', '')) has_any (hostname_has_any)
            or tostring(column_ifexists('RawData', '')) has_any (hostname_has_any)
        // Some environments populate "Message", others "RawData", depending on DCR
        // configuration. coalesce() is the wrong tool here: it only falls through on
        // null, not on empty string, so if both columns exist and Message is blank for a
        // given row, coalesce() would silently return "" instead of falling back to
        // RawData. case()+isnotempty() checks emptiness explicitly instead.
        | extend _RawMessage = trim(' ', case(
              isnotempty(column_ifexists('Message', '')), tostring(column_ifexists('Message', '')),
              isnotempty(column_ifexists('RawData', '')), tostring(column_ifexists('RawData', '')),
              ''
          ))
        | where isnotempty(_RawMessage)
        | extend _Parts = extract_all(
              @'^(\S+)\s+(\S+)\s+(\d+\.\d+)\s+(\S+)\s+(\S+)\s*([\S\s]*)$',
              dynamic([1, 2, 3, 4, 5, 6]),
              _RawMessage
          )[0]
        | where array_length(_Parts) == 6
        | extend
            SyslogHostname    = tostring(_Parts[1]),
            _EventEpoch       = toreal(_Parts[2]),   // fractional-second epoch; toreal keeps nanosecond precision that toint/tolong would truncate
            DvcHostname       = tostring(_Parts[3]),
            EventOriginalType = tostring(_Parts[4]),
            RawEventData      = trim(' ', tostring(_Parts[5]))
        | extend
            EventStartTime = unixtime_seconds_todatetime(_EventEpoch),
            EventEndTime   = unixtime_seconds_todatetime(_EventEpoch)
        | extend
            EventVendor  = 'Cisco',
            EventProduct = 'Meraki MX'
        | project-away _RawMessage, _Parts, _EventEpoch
    ;
    //
    // Branch 1: ip_flow_start / ip_flow_end -- raw flow tracking, no allow/deny decision.
    //
    let IpFlow =
        MerakiBase
        | where EventOriginalType in (IpFlowLogTypes)
        | parse-kv RawEventData as (
              src: string,
              dst: string,
              protocol: string,
              sport: long,
              dport: long,
              translated_src_ip: string,
              translated_dst_ip: string,
              translated_port: long
          ) with (pair_delimiter=' ', kv_delimiter='=')
        | extend
            EventType    = 'NetworkSession',
            EventSubType = iff(EventOriginalType == 'ip_flow_start', 'Start', 'End'),
            EventResult  = 'Success',
            NetworkProtocol = toupper(protocol),
            SrcIpAddr     = src,
            DstIpAddr     = dst,
            SrcPortNumber = sport,
            DstPortNumber = dport,
            SrcNatIpAddr  = translated_src_ip,
            DstNatIpAddr  = translated_dst_ip
        | extend
            // Meraki emits a single "translated_port" -- it belongs to whichever side
            // actually got translated (src-side for outbound/SNAT, dst-side for
            // inbound/DNAT). Confirmed against real samples of both directions.
            SrcNatPortNumber = iff(isnotempty(translated_src_ip), translated_port, long(null)),
            DstNatPortNumber = iff(isnotempty(translated_dst_ip), translated_port, long(null))
        | extend
            // A flow can only reach "tracked" state if the firewall didn't drop it --
            // a blocked packet never establishes a session. So DvcAction=Allow is a sound
            // inference here, even though Meraki does not literally state an action in
            // ip_flow_start/ip_flow_end messages. Flagged via _DvcActionInferred so this
            // stays distinguishable downstream from FirewallFlow rows where the device
            // explicitly logged the decision (e.g. for future rule-tuning audits).
            DvcAction         = 'Allow',
            DvcOriginalAction = EventOriginalType,
            _DvcActionInferred = true
        | extend
            NetworkDirection = case(
                ipv4_is_private(SrcIpAddr) and not(ipv4_is_private(DstIpAddr)), 'Outbound',
                not(ipv4_is_private(SrcIpAddr)) and ipv4_is_private(DstIpAddr), 'Inbound',
                ipv4_is_private(SrcIpAddr) and ipv4_is_private(DstIpAddr), 'Local',
                'NA'
            )
    ;
    //
    // Branch 2: firewall-rule-match logs (flows / firewall / vpn_firewall / cellular_firewall /
    // bridge_anyconnect_client_vpn_firewall). Two message shapes exist across firmware:
    //   old:  "flows allow src=... pattern: 1 all"      (leading allow/deny keyword)
    //   new:  "firewall src=... pattern: allow al"      (allow/deny only inside "pattern:")
    // Both are handled without needing to know which firmware produced the line.
    //
    let FirewallFlow =
        MerakiBase
        | where EventOriginalType in (FirewallLogTypes)
        | extend
            NetworkRuleName = extract(@'pattern:\s*(.*)$', 1, RawEventData),
            // Word form: outbound rules / firmware >= MX18.101, e.g. "pattern: allow al"
            _FlowAction1 = extract(@'pattern:\s*(allow|deny)\b', 1, RawEventData),
            // Leading-keyword form: oldest "flows allow src=..." layout
            _FlowAction2 = extract(@'^(allow|deny)\b', 1, RawEventData),
            // Numeric form: inbound rule matches encode the decision as a leading
            // digit instead of a word -- per Meraki's own syslog docs, 0=allow, 1=deny,
            // e.g. "pattern: 1 all". Without this, every inbound-rule-matched flow using
            // this convention silently loses its DvcAction.
            _FlowActionCode = extract(@'pattern:\s*(\d+)\b', 1, RawEventData)
        | extend _FlowAction = case(
              isnotempty(_FlowAction1), _FlowAction1,
              isnotempty(_FlowAction2), _FlowAction2,
              _FlowActionCode == '0', 'allow',
              _FlowActionCode == '1', 'deny',
              ''
          )
        | extend _BodyToParse = replace_regex(RawEventData, @'\s*pattern:\s*.*$', '')
        | extend _BodyToParse = replace_regex(_BodyToParse, @'^(allow|deny)\s+', '')
        | parse-kv _BodyToParse as (
              src: string,
              dst: string,
              mac: string,
              protocol: string,
              sport: long,
              dport: long,
              type: string   // unconfirmed against production samples so far -- app-layer
                              // identification field seen on some Advanced-Security-licensed
                              // deployments; parse-kv safely leaves this null if absent
          ) with (pair_delimiter=' ', kv_delimiter='=')
        | extend
            EventType    = 'NetworkSession',
            EventSubType = '',   // a rule match is a point-in-time event, not a session with a start/end
            EventResult  = case(_FlowAction == 'allow', 'Success', _FlowAction == 'deny', 'Failure', 'NA'),
            DvcAction    = case(_FlowAction == 'allow', 'Allow', _FlowAction == 'deny', 'Deny', ''),
            DvcOriginalAction = iff(isnotempty(_FlowAction), _FlowAction, EventOriginalType),
            _DvcActionInferred = false,
            NetworkProtocol  = toupper(protocol),
            NetworkApplicationProtocol = toupper(type),
            SrcIpAddr    = src,
            DstIpAddr    = dst,
            SrcPortNumber = sport,
            DstPortNumber = dport,
            SrcMacAddr   = mac
        | extend
            NetworkDirection = case(
                ipv4_is_private(SrcIpAddr) and not(ipv4_is_private(DstIpAddr)), 'Outbound',
                not(ipv4_is_private(SrcIpAddr)) and ipv4_is_private(DstIpAddr), 'Inbound',
                ipv4_is_private(SrcIpAddr) and ipv4_is_private(DstIpAddr), 'Local',
                'NA'
            )
        | project-away _FlowAction1, _FlowAction2, _FlowActionCode, _FlowAction, _BodyToParse
    ;
    //
    // Branch 3: AnyConnect VPN connection events, carried under the generic "events"
    // LogType. Example raw payload:
    //   type=anyconnect_vpn_connection_success msg= 'Local[85.1.111.98.443] Peer[10.57.23.15.1603] Prot[TCP] ...'
    // "Local[ip.port]" is the MX's own VPN endpoint (treated as Dst -- the connection's
    // target); "Peer[ip.port]" is the remote client (treated as Src). IPv4-in-brackets is
    // split from its trailing port by exploiting the fixed 4-octet shape of an IPv4 address.
    //
    let VpnConnectionEvent =
        MerakiBase
        | where EventOriginalType == 'events'
        | extend _EventKind = extract(@'^type=(\S+)', 1, RawEventData)
        | where _EventKind has VpnEventKeyword
        | extend _Msg = extract(@"msg=\s*'(.*)'\s*$", 1, RawEventData)
        | extend
            DstIpAddr     = extract(@'Local\[(\d+\.\d+\.\d+\.\d+)\.\d+\]', 1, _Msg),
            DstPortNumber = tolong(extract(@'Local\[\d+\.\d+\.\d+\.\d+\.(\d+)\]', 1, _Msg)),
            SrcIpAddr     = extract(@'Peer\[(\d+\.\d+\.\d+\.\d+)\.\d+\]', 1, _Msg),
            SrcPortNumber = tolong(extract(@'Peer\[\d+\.\d+\.\d+\.\d+\.(\d+)\]', 1, _Msg)),
            NetworkProtocol = toupper(extract(@'Prot\[(\w+)\]', 1, _Msg))
        | extend
            EventType    = 'NetworkSession',
            EventSubType = iff(_EventKind has 'success', 'Start', iff(_EventKind has_any ('terminated', 'failed'), 'End', '')),
            EventResult  = iff(_EventKind has 'success', 'Success', 'Failure'),
            DvcAction    = iff(_EventKind has 'success', 'Allow', 'Deny'),
            DvcOriginalAction = _EventKind,
            _DvcActionInferred = false,
            NetworkApplicationProtocol = 'SSL',   // AnyConnect uses TLS/DTLS
            NetworkDirection = 'Inbound'           // remote client terminating VPN on the MX
    ;
    union IpFlow, FirewallFlow, VpnConnectionEvent
    | extend
        EventCount          = toint(1),
        EventSchema         = 'NetworkSession',
        EventSchemaVersion  = _EventSchemaVersion,
        EventResultDetails  = '',
        Dvc                 = DvcHostname
    | extend AdditionalFields = bag_pack('SyslogHostname', SyslogHostname, 'DvcActionInferred', _DvcActionInferred)
    // ---- ASIM parameter-based filtering (exact match, post-parse) ----
    | where array_length(src_or_any) == 0 or has_any_ipv4_prefix(SrcIpAddr, src_or_any)
    | where array_length(dst_or_any) == 0 or has_any_ipv4_prefix(DstIpAddr, dst_or_any)
    | where isnull(dstportnumber) or DstPortNumber == dstportnumber
    | where array_length(hostname_has_any) == 0 or DvcHostname has_any (hostname_has_any)
    | where array_length(dvcaction) == 0 or DvcAction has_any (dvcaction)
    | where eventresult == '*' or EventResult == eventresult
    | project
        TimeGenerated,
        EventCount,
        EventStartTime,
        EventEndTime,
        EventType,
        EventSubType,
        EventResult,
        EventResultDetails,
        EventOriginalType,
        EventProduct,
        EventVendor,
        EventSchema,
        EventSchemaVersion,
        Dvc,
        DvcHostname,
        DvcAction,
        DvcOriginalAction,
        SrcIpAddr,
        SrcPortNumber,
        DstIpAddr,
        DstPortNumber,
        SrcNatIpAddr,
        SrcNatPortNumber,
        DstNatIpAddr,
        DstNatPortNumber,
        SrcMacAddr,
        NetworkProtocol,
        NetworkApplicationProtocol,
        NetworkDirection,
        NetworkRuleName,
        AdditionalFields
    // Optional pass-through columns: uncomment only after confirming they actually exist
    // in your meraki_CL schema (meraki_CL | getschema). Do not reference them unguarded --
    // this is exactly the mistake that breaks _Im_NetworkSession_CiscoMerakiV12 against
    // AMA-ingested tables (it hardcodes a reference to "SourceSystem", which AMA/DCR
    // ingestion never creates).
    // | extend _ResourceId = column_ifexists('_ResourceId', ''), LE_CF = column_ifexists('LE_CF', '')
};
// -----------------------------------------------------------------------------------------
// DEPLOYMENT
// -----------------------------------------------------------------------------------------
// 1. Paste this entire file into Log Analytics / Microsoft Sentinel > Logs.
// 2. Run it once with a test call appended, e.g.:
//        vimNetworkSessionCiscoMerakiCustom(ago(1d), now(), dynamic([]), dynamic([]), dynamic([]), int(null), dynamic([]), dynamic([]), '*', false)
//    to confirm it returns rows and the schema looks right.
// 3. Remove the test call, then use "Save as Function", name it exactly
//    vimNetworkSessionCiscoMerakiCustom, and keep the parameter list as-is.
// 4. Register this name in the workspace-deployed Im_NetworkSessionCustom function's
//    "Custom" slot (see normalization-manage-parsers docs) so _Im_NetworkSession() and
//    ASIM-based analytics/workbooks pick it up automatically.
vimNetworkSessionCiscoMerakiCustom
