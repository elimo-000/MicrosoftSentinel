// =============================================================================================
// ASIM Dns Parser (parameter-less / "ASim") -- Cisco Umbrella (Custom, CCF connector)
// =============================================================================================
// Thin wrapper around vimDnsCiscoUmbrellaCCFCustom, called with no-op filter values. This is
// the standard ASIM parameterless-parser pattern: it exists so tools/queries that expect a
// (near-)zero-argument view of the schema have something to call directly, and so it can be
// registered as a Kusto view for auto-discovery by _ASim_Dns().
//
// DEPENDENCY: vimDnsCiscoUmbrellaCCFCustom must already be saved as a function in this
// workspace before saving this one -- deploy vimDnsCiscoUmbrellaCCFCustom.kql first.
//
// Source table   : CiscoUmbrellaDNS_CL
// Ingestion path : Cisco Umbrella data connector, Codeless Connector Framework (CCF) variant
// Schema         : ASIM Dns, schema version 0.1.3
//
// DEPLOYMENT
// -----------------------------------------------------------------------------------------
// 1. Confirm vimDnsCiscoUmbrellaCCFCustom is already saved as a function.
// 2. Paste this file into Log Analytics / Microsoft Sentinel > Logs and run it to confirm
//    it returns rows.
// 3. "Save as Function", name it exactly ASimDnsCiscoUmbrellaCCFCustom.
// 4. Register this name in the workspace-deployed ASim_DnsCustom "Custom" slot so
//    _ASim_Dns() picks it up automatically alongside the built-in sources.
// =============================================================================================
let ASimDnsCiscoUmbrellaCCFCustom = (disabled:bool=false) {
    vimDnsCiscoUmbrellaCCFCustom(
        starttime = datetime(null),
        endtime = datetime(null),
        srcipaddr = '*',
        domain_has_any = dynamic([]),
        responsecodename = '*',
        response_has_ipv4 = '*',
        response_has_any_prefix = dynamic([]),
        eventtype = 'Query',
        disabled = disabled
    )
};
ASimDnsCiscoUmbrellaCCFCustom(disabled)
