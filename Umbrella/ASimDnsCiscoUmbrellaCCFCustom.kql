// =============================================================================================
// ASIM Dns Parser (parameter-less / "ASim") -- Cisco Umbrella (Custom, CCF connector)
// =============================================================================================
// NOTE: unlike the standard ASIM custom-source pattern (and unlike this repo's Meraki/
// pfSense/SonicWall ASim wrappers), this function does NOT call vimDnsCiscoUmbrellaCCFCustom.
// As deployed in the workspace, it carries its own inline copy of the same parsing logic,
// exposing only the "disabled" parameter (no time/filter parameters). Exported here exactly
// as saved in the workspace -- consider refactoring to a thin wrapper around
// vimDnsCiscoUmbrellaCCFCustom for consistency with the other parsers in this repo.
//
// Source table   : CiscoUmbrellaDNS_CL
// Ingestion path : Cisco Umbrella data connector, Codeless Connector Framework (CCF) variant
// Schema         : ASIM Dns, schema version 0.1.3
//
// DEPLOYMENT
// -----------------------------------------------------------------------------------------
// 1. Paste this file into Log Analytics / Microsoft Sentinel > Logs and run it to confirm
//    it returns rows.
// 2. "Save as Function", name it exactly ASimDnsCiscoUmbrellaCCFCustom.
// 3. Register this name in the workspace-deployed ASim_DnsCustom "Custom" slot so
//    _ASim_Dns() picks it up automatically alongside the built-in sources.
// =============================================================================================
let DNSQuery_CiscoUmbrella=(disabled:bool=false){
    CiscoUmbrellaDNS_CL | where not(disabled)
    //
    // *********** Parsing
| parse QueryType with DnsQueryType:int " ("DnsQueryTypeName:string ")"
    //
    | project
    //
    // ******************* Mandatory
 EventCount=int(1),
      EventStartTime=todatetime(column_ifexists('Timestamp', '')),
      EventProduct="Umbrella",
      EventVendor="Cisco",
      EventSchema="Dns",
      EventSchemaVersion="0.1.3",
      Dvc="CiscoUmbrella" ,
      EventType="Query",
      EventResult=iff(ResponseCode=~'NOERROR','Success','Failure'),
      EventResultDetails=ResponseCode,  // => ResponseCodeNames
      //
      TimeGenerated, // not handled by schema, but we need to preserve it
      SrcIpAddr=tostring(column_ifexists('InternalIp', '')),
      EventSubType='response',
  // ********** Renamed columns
      UrlCategory=column_ifexists('Categories', ''),
      DnsQuery=trim_end(@'\.',column_ifexists('Domain', '')) ,
      ThreatCategory=tostring(column_ifexists('BlockedCategories', '')),
      SrcNatIpAddr=column_ifexists('ExternalIp', ''),
      DvcAction=column_ifexists('Action', ''),
      EventEndTime=todatetime(column_ifexists('Timestamp', '')),
  //
  // *************** keep Parsed data
      DnsQueryType, DnsQueryTypeName
  // **************Aliases
  | extend
      DnsResponseCodeName=EventResultDetails,
      DomainCategory=UrlCategory,
      Domain=DnsQuery,
      IpAddr=SrcIpAddr,
      Src=SrcIpAddr
  };
DNSQuery_CiscoUmbrella(disabled)
