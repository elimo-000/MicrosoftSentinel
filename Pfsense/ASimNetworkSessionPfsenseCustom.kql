// =============================================================================================
// ASIM NetworkSession Parser (parameter-less / "ASim") -- Netgate pfSense filterlog (Custom, CEF)
// =============================================================================================
// Thin wrapper around vimNetworkSessionPfsenseCustom, called with no-op filter values. This is
// the standard ASIM parameterless-parser pattern: it exists so tools/queries that expect a
// (near-)zero-argument view of the schema have something to call directly, and so it can be
// registered for auto-discovery by _ASim_NetworkSession().
//
// LEGACY PATH (CommonSecurityLog / CEF): kept while devices migrate to the raw Syslog path
// (ASimNetworkSessionPfsenseSyslogCustom). Never register both parsers for the same device.
//
// DEPENDENCY: vimNetworkSessionPfsenseCustom must already be saved as a function in this
// workspace before saving this one -- deploy vimNetworkSessionPfsenseCustom.kql first.
//
// DEPLOYMENT
// -----------------------------------------------------------------------------------------
// 1. Confirm vimNetworkSessionPfsenseCustom is already saved as a function.
// 2. Paste this file into Log Analytics / Microsoft Sentinel > Logs and run it to confirm
//    it returns rows.
// 3. "Save as Function", name it exactly ASimNetworkSessionPfsenseCustom.
// 4. Register this name in the workspace-deployed ASim_NetworkSessionCustom "Custom" slot.
// =============================================================================================
let ASimNetworkSessionPfsenseCustom = (disabled:bool=false) {
    vimNetworkSessionPfsenseCustom(
        starttime = datetime(null),
        endtime = datetime(null),
        srcipaddr_has_any_prefix = dynamic([]),
        dstipaddr_has_any_prefix = dynamic([]),
        ipaddr_has_any_prefix = dynamic([]),
        dstportnumber = int(null),
        hostname_has_any = dynamic([]),
        dvcaction = dynamic([]),
        eventresult = '*',
        disabled = disabled
    )
};
ASimNetworkSessionPfsenseCustom(disabled)
