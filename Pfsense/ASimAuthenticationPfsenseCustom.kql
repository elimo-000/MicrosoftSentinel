// =============================================================================================
// ASIM Authentication Parser (parameter-less / "ASim") -- Netgate pfSense (Custom, raw Syslog)
// =============================================================================================
// Thin wrapper around vimAuthenticationPfsenseCustom, called with no-op filter values. This is
// the standard ASIM parameterless-parser pattern: it exists so tools/queries that expect a
// (near-)zero-argument view of the schema have something to call directly, and so it can be
// registered for auto-discovery by _ASim_Authentication().
//
// DEPENDENCY: vimAuthenticationPfsenseCustom must already be saved as a function in this
// workspace before saving this one -- deploy vimAuthenticationPfsenseCustom.kql first.
//
// Source table   : Syslog (raw pfSense path with the "[pfsense]" marker)
// Schema         : ASIM Authentication, schema version 1.0.0
//
// DEPLOYMENT
// -----------------------------------------------------------------------------------------
// 1. Confirm vimAuthenticationPfsenseCustom is already saved as a function.
// 2. Paste this file into Log Analytics / Microsoft Sentinel > Logs and run it to confirm
//    it returns rows.
// 3. "Save as Function", name it exactly ASimAuthenticationPfsenseCustom.
// 4. Register this name in the workspace-deployed ASim_AuthenticationCustom "Custom" slot so
//    _ASim_Authentication() picks it up automatically alongside the built-in sources.
// =============================================================================================
let ASimAuthenticationPfsenseCustom = (disabled:bool=false) {
    vimAuthenticationPfsenseCustom(
        starttime = datetime(null),
        endtime = datetime(null),
        username_has_any = dynamic([]),
        targetappname_has_any = dynamic([]),
        srcipaddr_has_any_prefix = dynamic([]),
        srchostname_has_any = dynamic([]),
        eventtype_in = dynamic([]),
        eventresultdetails_in = dynamic([]),
        eventresult = '*',
        disabled = disabled
    )
};
ASimAuthenticationPfsenseCustom(disabled)
