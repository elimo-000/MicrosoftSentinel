// =============================================================================================
// ASIM WebSession Parser (parameter-based / "vim") -- Cloudflare Gateway HTTP (Custom, CCF connector)
// =============================================================================================
// Source table   : CloudflareV2_CL (Logpush dataset "gateway_http")
// Ingestion path : Cloudflare Logpush -> storage -> Cloudflare data connector, Codeless Connector
//                  Framework (CCF) variant
// Schema         : ASIM WebSession, schema version 1.0.0 (verify against current docs at deploy time --
//                  https://learn.microsoft.com/azure/sentinel/normalization-schema-web)
//
// WHY THIS PARSER EXISTS
// -----------------------------------------------------------------------------------------
// Microsoft ships no ASIM parser for Cloudflare. Cloudflare Gateway is the outbound secure web
// gateway (WARP clients / Zero Trust); its HTTP-layer decisions belong in WebSession, while the
// L4 decisions and session summaries of the same connections are in
// vimNetworkSessionCloudflareGatewayCustom (pivot on NetworkSessionId = SessionID).
//
// SOURCE SELECTION
// -----------------------------------------------------------------------------------------
// gateway_http rows are the only ones with HTTPMethod. Rows with HTTPMethod "UNKNOWN" are skipped:
// they are TLS connections that Gateway did not inspect ("bypass" / Do Not Inspect policies), with
// no URL, host or status, so they cannot fill the mandatory Url field; their L4 data is already
// in the NetworkSession parser. Only inspected traffic (plain HTTP, or HTTPS with TLS inspection)
// is returned.
// The output keeps only the gateway_http columns (project-keep), plus TimeGenerated, _ItemId,
// Type, TenantId and _ResourceId, so ingestion_time() keeps working on the parser output.
//
// FIELD MAPPING NOTES
// -----------------------------------------------------------------------------------------
// - TimeGenerated is when the connector pulled the Logpush batch; EventStartTime = Datetime.
// - SrcIpAddr = SourceInternalIP (WARP virtual/CGNAT address, or the LAN address behind a
//   GRE/IPsec on-ramp), falling back to SourceIP; the client's public IP (SourceIP) is kept in
//   AdditionalFields.SourcePublicIP, and SrcGeoCountry is the country of that public IP.
// - SrcHostname/SrcDomain/SrcFQDN from DeviceName, which is sometimes a FQDN (e.g. "<host>.local");
//   user-set names that are not valid host names (spaces, underscores, IPs) go to SrcDescription.
//   DstFQDN/DstHostname/DstDomain from HTTPHost (port stripped).
// - DvcAction: Action containing "block" -> Deny; allow/bypass/isolate/scan variants -> Allow;
//   anything else is left empty (raw value always in DvcOriginalAction).
// - EventResultDetails = HTTPStatusCode; 0 (no response, e.g. client disconnected) -> "NA".
// - SrcUserId is not set: the Cloudflare user UUID is not one of the ASIM UserIdType values; it is
//   in AdditionalFields.UserID.
// =============================================================================================
let WebSessionCloudflareGateway=(
  starttime:datetime=datetime(null), endtime:datetime=datetime(null)
  , srcipaddr_has_any_prefix:dynamic=dynamic([])
  , ipaddr_has_any_prefix:dynamic=dynamic([])
  , url_has_any:dynamic=dynamic([])
  , httpuseragent_has_any:dynamic=dynamic([])
  , eventresultdetails_in:dynamic=dynamic([])
  , eventresult:string='*'
  , disabled:bool=false
  ){
    CloudflareV2_CL | where not(disabled)
    // ******************************************************************
    //  Pre-parsing filtering (physical columns only):
      | where
        (isnull(starttime) or TimeGenerated >= starttime)
        and (isnull(endtime) or TimeGenerated <= endtime)
        and isnotempty(HTTPMethod) and HTTPMethod != "UNKNOWN"
        and (array_length(srcipaddr_has_any_prefix) == 0 or has_any_ipv4_prefix(coalesce(SourceInternalIP, SourceIP), srcipaddr_has_any_prefix))
        and (array_length(ipaddr_has_any_prefix) == 0 or has_any_ipv4_prefix(coalesce(SourceInternalIP, SourceIP), ipaddr_has_any_prefix) or has_any_ipv4_prefix(DestinationIP, ipaddr_has_any_prefix))
        and (array_length(url_has_any) == 0 or URL has_any (url_has_any))
        and (array_length(httpuseragent_has_any) == 0 or UserAgent has_any (httpuseragent_has_any))
        and (array_length(eventresultdetails_in) == 0 or tostring(HTTPStatusCode) in (eventresultdetails_in))
    // *****************************************************************
    | project-keep TimeGenerated, _ItemId, Type, TenantId, _ResourceId,
        AccountID, Action, ApplicationIDs, ApplicationNames, BlockedFileHash, BlockedFileName,
        BlockedFileReason, BlockedFileSize, BlockedFileType, CategoryIDs, CategoryNames, Datetime,
        DestinationIP, DestinationIPContinentCode, DestinationIPCountryCode, DestinationPort, DeviceID,
        DeviceName, DownloadMatchedDlpProfileEntries, DownloadMatchedDlpProfiles, DownloadedFileNames,
        Email, FileInfo, ForensicCopyStatus, HTTPHost, HTTPMethod, HTTPStatusCode, HTTPVersion,
        IsIsolated, PolicyID, PolicyName, PrivateAppAUD, ProxyEndpoint, Quarantined, RedirectTargetURI,
        Referer, RegistrationID, RequestID, SessionID, SourceIP, SourceIPContinentCode,
        SourceIPCountryCode, SourceInternalIP, SourcePort, URL, UntrustedCertificateAction,
        UploadMatchedDlpProfileEntries, UploadMatchedDlpProfiles, UploadedFileNames, UserAgent, UserID,
        VirtualNetworkID, VirtualNetworkName
    //
    | extend
    //
    // ******************* Mandatory
      EventCount=int(1),
      EventStartTime=todatetime(Datetime),
      EventEndTime=todatetime(Datetime),
      EventProduct="Gateway",
      EventVendor="Cloudflare",
      EventSchema="WebSession",
      EventSchemaVersion="1.0.0",
      Dvc="Gateway",
      EventType="HTTPsession",
      Url=URL,
      EventResult=case(
          HTTPStatusCode == 0 or isnull(HTTPStatusCode), "NA",
          HTTPStatusCode < 400, "Success",
          "Failure")
    | where eventresult == '*' or EventResult =~ eventresult
  // ********** Recommended
  | extend
      EventResultDetails=iff(HTTPStatusCode > 0, tostring(HTTPStatusCode), "NA"),
      EventUid=_ItemId,
      SrcIpAddr=coalesce(SourceInternalIP, SourceIP),
      DvcOriginalAction=Action,
      DvcAction=case(
          Action has "block", "Deny",
          Action in~ ("allow", "bypass", "isolate", "doNotIsolate", "scan", "doNotScan", "noScan"), "Allow",
          ""),
      HttpRequestMethod=HTTPMethod
  | extend EventSeverity=iff(DvcAction == "Deny", "Low", "Informational")
  // DeviceName is user-set: a valid host name / FQDN goes to SrcHostname/SrcFQDN, anything else
  // (spaces, underscores, an IP address, ...) to SrcDescription
  | extend _DevIsHost=DeviceName matches regex @"^[A-Za-z0-9-]{1,63}(\.[A-Za-z0-9-]{1,63})*$" and isnull(parse_ipv4(DeviceName))
  // ********** Optional
  | extend
      EventOriginalUid=RequestID,
      DvcScopeId=AccountID,
      DvcZone=VirtualNetworkName,
      SrcPortNumber=SourcePort,
      SrcGeoCountry=SourceIPCountryCode,
      SrcHostname=iff(_DevIsHost, tostring(split(DeviceName, ".")[0]), ""),
      SrcFQDN=iff(_DevIsHost and DeviceName contains ".", DeviceName, ""),
      SrcDomain=iff(_DevIsHost and DeviceName contains ".", substring(DeviceName, indexof(DeviceName, ".") + 1), ""),
      SrcDomainType=iff(_DevIsHost and DeviceName contains ".", "FQDN", ""),
      SrcDescription=iff(_DevIsHost, "", DeviceName),
      SrcDvcId=DeviceID,
      SrcDvcIdType=iff(isnotempty(DeviceID), "Other", ""),
      SrcUsername=Email,
      SrcUsernameType=case(isempty(Email), "", Email contains "@", "UPN", "Simple"),
      DstIpAddr=DestinationIP,
      DstPortNumber=DestinationPort,
      DstGeoCountry=DestinationIPCountryCode,
      _Host=iff(HTTPHost startswith "[", "", tostring(split(HTTPHost, ":")[0])),
      HttpHost=HTTPHost,
      HttpVersion=case(
          HTTPVersion == "HTTP/1.0", "1.0",
          HTTPVersion == "HTTP/1.1", "1.1",
          HTTPVersion == "HTTP/2", "2.0",
          HTTPVersion == "HTTP/3", "3.0",
          ""),
      HttpUserAgent=UserAgent,
      HttpReferrer=Referer,
      HttpIsProxied=true,
      NetworkApplicationProtocol=toupper(tostring(split(URL, ":")[0])),
      NetworkProtocol="TCP",
      NetworkDirection="Outbound",
      NetworkSessionId=SessionID,
      RuleName=PolicyName,
      UrlCategory=strcat_array(todynamic(CategoryNames), ","),
      FileName=tostring(todynamic(UploadedFileNames)[0])
  // destination name = the requested virtual host (Host header, port stripped); empty when it is an IP
  | extend _HostIsName=isnotempty(_Host) and isnull(parse_ipv4(_Host))
  | extend
      DstFQDN=iff(_HostIsName and _Host contains ".", _Host, ""),
      DstHostname=iff(_HostIsName, tostring(split(_Host, ".")[0]), ""),
      DstDomain=iff(_HostIsName and _Host contains ".", substring(_Host, indexof(_Host, ".") + 1), ""),
      DstDomainType=iff(_HostIsName and _Host contains ".", "FQDN", "")
  // *************** AdditionalFields: identity, file and DLP detail that has no ASIM field
  | extend AdditionalFields=bag_pack(
        "SourcePublicIP", SourceIP,
        "UserID", UserID,
        "PolicyID", PolicyID,
        "ApplicationNames", ApplicationNames,
        "IsIsolated", IsIsolated,
        "UntrustedCertificateAction", UntrustedCertificateAction,
        "BlockedFileName", BlockedFileName,
        "BlockedFileHash", BlockedFileHash,
        "BlockedFileReason", BlockedFileReason,
        "UploadedFileNames", UploadedFileNames,
        "DownloadedFileNames", DownloadedFileNames,
        "UploadMatchedDlpProfiles", UploadMatchedDlpProfiles,
        "DownloadMatchedDlpProfiles", DownloadMatchedDlpProfiles
    )
  // **************Aliases
  | extend
      IpAddr=SrcIpAddr,
      Src=SrcIpAddr,
      Dst=DstIpAddr,
      Hostname=DstHostname,
      User=SrcUsername,
      SessionId=NetworkSessionId,
      HttpStatusCode=EventResultDetails,
      Rule=coalesce(RuleName, PolicyID)
  | extend
      ASimMatchingIpAddr=case(
          array_length(ipaddr_has_any_prefix) == 0, "-",
          has_any_ipv4_prefix(SrcIpAddr, ipaddr_has_any_prefix) and has_any_ipv4_prefix(DstIpAddr, ipaddr_has_any_prefix), "Both",
          has_any_ipv4_prefix(SrcIpAddr, ipaddr_has_any_prefix), "SrcIpAddr",
          "DstIpAddr"),
      ASimMatchingHostname="-"   // WebSession has no hostname filter parameter
  | project-away _Host, _HostIsName, _DevIsHost
  };
WebSessionCloudflareGateway(starttime, endtime, srcipaddr_has_any_prefix, ipaddr_has_any_prefix, url_has_any, httpuseragent_has_any, eventresultdetails_in, eventresult, disabled)
// -----------------------------------------------------------------------------------------
// DEPLOYMENT
// -----------------------------------------------------------------------------------------
// 1. Paste this entire file into Log Analytics / Microsoft Sentinel > Logs.
// 2. Replace the last line with a test call, e.g.:
//        WebSessionCloudflareGateway(ago(1h), now())
//    to confirm it returns rows.
// 3. Restore the last line, then use "Save as Function", name it exactly
//    vimWebSessionCloudflareGatewayCustom, and keep the parameter list as-is
//    (or deploy vimWebSessionCloudflareGatewayCustom.json).
// 4. Register this name in the workspace-deployed Im_WebSessionCustom function's "Custom" slot
//    so _Im_WebSession() and ASIM-based analytics/workbooks pick it up automatically.
